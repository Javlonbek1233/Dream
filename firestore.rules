rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    // --- Dreams ---
    function isValidDream(data) {
      return data.userId == request.auth.uid &&
             data.content is string && data.content.size() <= 5000 &&
             data.analysis is map &&
             data.metadata is map;
    }

    match /dreams/{dreamId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidDream(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidDream(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    // --- Community Dreams ---
    match /community_dreams/{dreamId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.metadata.isPublic == true;
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
